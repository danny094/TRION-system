{
  "schema_version": 1,
  "id": "container-commander",
  "display_name": "Container Commander",
  "version": "2.1.0",
  "description": "Container lifecycle management for TRION — Blueprints, Resources, Security and Logs.",
  "transport": "stdio",
  "entry": {
    "type": "stdio",
    "command": ".venv/bin/python server.py"
  },
  "ui": {
    "icon": "assets/icon.svg",
    "launchpad": {
      "enabled": false,
      "label": "Container Commander"
    },
    "settings": {
      "enabled": false,
      "mode": "config"
    }
  },
  "install": {
    "healthcheck": {
      "enabled": false
    },
    "runtime": {
      "kind": "venv"
    }
  }
}
